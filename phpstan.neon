includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Larastan: parse casts() method bodies so date/datetime attributes type as Carbon
    # (models use casts() with @return array<string, string>, which otherwise hides cast keys).
    parseModelCastsMethod: true

    # Larastan often types nullable date casts as non-null Carbon; Resources still need ?-> at runtime.
    ignoreErrors:
        - identifier: nullsafe.neverNull
